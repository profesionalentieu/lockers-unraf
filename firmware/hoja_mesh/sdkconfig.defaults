# Hoja de la mesh del gabinete de lockers. Placa por defecto: ESP32-C3 SuperMini (4 MB),
# la de las hojas de AURA. Para la Seeed XIAO ESP32S3 (gabinete con 74HC595) se cambia el
# target a esp32s3 y ESP-IDF suma sdkconfig.defaults.esp32s3.
# Si cambiás este archivo, borrá sdkconfig y build antes de compilar.
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Tabla propia de la cátedra: dos lugares de 1,75 MB para el firmware (actualización por la malla)
# + partición "cola" (respaldo en flash de las mediciones que pasan 5 min sin que AURA las
# confirme). No cambiarla.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Una versión nueva que no logra hablar con la raíz vuelve sola a la anterior
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Consola por el USB nativo de la placa (la SuperMini no tiene chip USB-serie)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Tick de 1 ms: el antirrebote y los pulsos se miden en milisegundos
CONFIG_FREERTOS_HZ=1000

# Imágenes firmadas (PR #36 de aura-firmware, guía 2.9): la placa solo instala por OTA una imagen
# firmada con la clave de la cátedra (RSA-3072, esquema de Secure Boot V2, sin quemar eFuses).
# La compilación NO firma: para conectarse y mandar datos no hace falta. Si tenías un sdkconfig
# de antes, borralo (Full Clean) para que se apliquen estas opciones.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
# CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES is not set
