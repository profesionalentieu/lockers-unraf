# Seeed XIAO ESP32S3 (8 MB): gabinete con SN74HC595. Se suma a sdkconfig.defaults cuando
# el target es esp32s3. La partición "cola" queda en el mismo lugar (los primeros 2 MB).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# La consola por el USB nativo es IMPRESCINDIBLE acá: D6 y D7 (GPIO43/44) son los
# microswitches 3 y 4, y con la consola en UART0 esos pines son TX y RX.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
