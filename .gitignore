# Dependencias
node_modules/

# Base de datos: se regenera con `npm run seed`.
# Van los tres archivos: SQLite en modo WAL crea .db-wal y .db-shm al lado.
data/
*.db
*.db-wal
*.db-shm

# Configuracion con secretos. Se versiona .env.example, nunca .env:
# adentro van el JWT_SECRET y la API key del gateway.
.env
.env.local

# Python (simulador alternativo)
__pycache__/
*.pyc

# Firmware ESP-IDF: lo que se genera al compilar. dependencies.lock SÍ se versiona.
firmware/**/build/
firmware/**/managed_components/
firmware/**/sdkconfig
firmware/**/sdkconfig.old
*.bin
*.elf

# Configuración local de cada placa (red WiFi, clave, API key). Este repo es público.
config_local.h

# Sistema operativo y editores
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
