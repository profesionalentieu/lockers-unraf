# ---- Servidor ----
PORT=3000

# ---- Seguridad ----
# Clave para firmar los JWT de alumnos y administrativos. Cambiar en produccion.
JWT_SECRET=cambiar-esta-clave-en-produccion
JWT_EXPIRA_ALUMNO=2h
JWT_EXPIRA_ADMIN=8h

# API key que usa el Gateway LoRa para autenticarse contra /api/gateway/*
# El gateway es una maquina, no una persona: usa API key fija, no JWT.
GATEWAY_API_KEY=gw-lora-unraf-2025

# ---- Reglas operativas ----
# Minutos que una solicitud espera aprobacion de Alumnado antes de caducar sola
SOLICITUD_CADUCA_MIN=15
# Segundos que puede estar una puerta abierta antes de marcarla como ERROR/TRABADA
PUERTA_ABIERTA_MAX_SEG=120
# Segundos que espera el backend el ACK del gateway antes de reintentar el comando.
# Con ESP-NOW el ida y vuelta son milisegundos; 5 s ya es holgado. Con LoRa hacian falta 15.
COMANDO_TIMEOUT_SEG=5
# Reintentos maximos de un comando de apertura antes de marcarlo fallido
COMANDO_MAX_INTENTOS=3
# Segundos sin heartbeat de un nodo para considerarlo desconectado
NODO_OFFLINE_SEG=180
