# ---- Servidor ----
PORT=3000

# URL que va impresa en los QR de las puertas (la IP de la notebook en la red).
# Si se deja vacia, la hoja de QR permite escribirla al momento de imprimir.
URL_PUBLICA=

# ---- Seguridad ----
# Clave para firmar los JWT. Cambiar en produccion.
JWT_SECRET=cambiar-esta-clave-en-produccion
JWT_EXPIRA_USUARIO=2h
JWT_EXPIRA_ADMIN=8h
# Token corto que recibe la pantalla del locker al validar un codigo
JWT_EXPIRA_OPERACION=20m

# API key del gateway de radio / placa WiFi (header x-api-key).
# El gateway es una maquina, no una persona: usa API key fija, no JWT.
GATEWAY_API_KEY=gw-lora-unraf-2025

# ---- Reloj ----
# Argentina no tiene horario de verano: un desplazamiento fijo alcanza.
ZONA_HORARIA=-03:00

# ---- Reglas de la especificacion (valores por defecto) ----
HORARIO_APERTURA=08:00
HORARIO_CIERRE=22:00
# Las horas de inicio van en pasos de este tamano
PASO_FRANJA_MIN=15
# Tolerancia para retirar desde la hora de inicio (despues: CANCELADO_NO_SHOW)
TOLERANCIA_RETIRO_MIN=15
# Buffer tecnico despues de la hora limite / de la devolucion
BUFFER_POSDEVOLUCION_MIN=30
# Hasta cuantos dias adelante reserva un docente
DOCENTE_DIAS_ANTICIPACION=7
# A cuantos minutos del turno siguiente se verifica si hay stock para cubrirlo
MITIGACION_ANTICIPACION_MIN=15

# ---- Hardware ----
# Tiempo que el solenoide queda energizado (ventana para tirar de la puerta)
PULSO_APERTURA_SEG=15
# Alerta de puerta mal cerrada
ALERTA_PUERTA_ABIERTA_SEG=45
# Mas que esto con la puerta abierta: el locker pasa a ERROR (trabado)
PUERTA_ABIERTA_MAX_SEG=120
# Una apertura que nunca abrio la puerta se abandona (libera el locker)
OPERACION_ABANDONO_SEG=120
# Segundos que espera el backend el ACK antes de reintentar el comando
COMANDO_TIMEOUT_SEG=5
COMANDO_MAX_INTENTOS=3
# Una orden que el gateway no tomo en este tiempo se descarta (no abre tarde)
COMANDO_VIGENCIA_SEG=30
# Segundos sin heartbeat de un nodo para considerarlo desconectado
NODO_OFFLINE_SEG=180

# ---- Pantalla del locker ----
# Codigos incorrectos permitidos por IP antes de bloquear un rato
ACCESO_INTENTOS_MAX=8
ACCESO_VENTANA_SEG=300

# Cada cuanto corre el watchdog (la especificacion pide 5000 ms)
WATCHDOG_INTERVALO_MS=5000
